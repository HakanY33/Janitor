{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo:*)",
      "Bash(sudo:*)",
      "Read(.env)",
      "Read(.env.*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(pip install:*)"
    ],
    "defaultMode": "default"
  },
  "includeCoAuthoredBy": false
}
